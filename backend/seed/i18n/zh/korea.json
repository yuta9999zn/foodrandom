        "amount": "3汤匙"
      },
      {
        "name": "酱油",
        "amount": "1汤匙"
      },
      {
        "name": "蒜末",
        "amount": "1汤匙"
      },
      {
        "name": "熟芝麻、花生碎",
        "amount": "2汤匙"
      }
