# ===== FoodRandom API — cấu hình qua biến môi trường =====
# Sao chép thành .env khi chạy trực tiếp bằng `cargo run`.

APP_ENV=development
HOST=0.0.0.0
PORT=8180
LOG_LEVEL=info
# json | pretty
LOG_FORMAT=pretty

# PostgreSQL
DATABASE_URL=postgres://foodrandom:foodrandom@127.0.0.1:54331/foodrandom
DB_MAX_CONNECTIONS=20
RUN_MIGRATIONS=true

# Nạp dữ liệu món ăn từ thư mục seed khi khởi động (upsert theo slug)
SEED_ON_START=true
SEED_DIR=./seed/foods

# Redis: OTP, giới hạn tần suất, cache danh sách món và địa điểm
REDIS_URL=redis://127.0.0.1:63791

# Phiên đăng nhập (JWT trong cookie httpOnly). ĐỔI giá trị này ở production (>= 32 ký tự).
JWT_SECRET=dev-only-change-me-please-32-chars-minimum
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# Danh sách origin được phép gọi API trực tiếp (CORS), cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:3100

# Email (gửi OTP và mật khẩu). Development dùng Mailpit: http://localhost:8125
SMTP_HOST=127.0.0.1
SMTP_PORT=1125
SMTP_USERNAME=
SMTP_PASSWORD=
# none | starttls | tls
SMTP_TLS=none
MAIL_FROM=FoodRandom <no-reply@foodrandom.local>

# Địa điểm
# auto: dùng Google nếu có GOOGLE_MAPS_API_KEY, ngược lại dùng OpenStreetMap (dữ liệu thật, không cần key)
# google | osm | mock  (mock = dữ liệu GIẢ LẬP, chỉ dùng để phát triển giao diện)
LOCATION_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# User-Agent gửi tới dịch vụ OpenStreetMap (bắt buộc theo chính sách sử dụng)
OSM_USER_AGENT=FoodRandom/0.1 (food discovery web app)

# Giới hạn tải
MAX_CONCURRENT_REQUESTS=2048
REQUEST_TIMEOUT_SECS=20
FOOD_CACHE_TTL_SECS=60
