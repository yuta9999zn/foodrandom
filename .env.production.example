# Sao chép thành .env.production và điền giá trị thật. KHÔNG đưa file đã điền vào git.

PUBLIC_URL=https://foodrandom.example.com
HTTP_PORT=80

POSTGRES_USER=foodrandom
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=foodrandom
DB_MAX_CONNECTIONS=25

# Chuỗi ngẫu nhiên tối thiểu 32 ký tự, ví dụ: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECURE=true

# Máy chủ gửi email OTP / mật khẩu (ví dụ Amazon SES, SendGrid, Mailgun, Gmail SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
MAIL_FROM=FoodRandom <no-reply@foodrandom.example.com>

# Địa điểm: có key thì dùng Google Maps Platform (Places API New + Geocoding API), không có thì OpenStreetMap.
LOCATION_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
