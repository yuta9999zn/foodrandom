# Sao chép thành .env.production và điền giá trị thật. KHÔNG đưa file đã điền vào git.

PUBLIC_URL=https://foodrandom.example.com
HTTP_PORT=80

POSTGRES_USER=foodrandom
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=foodrandom
DB_MAX_CONNECTIONS=25

# Địa điểm: có key thì dùng Google Maps Platform (Places API New + Geocoding API), không có thì OpenStreetMap.
LOCATION_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
